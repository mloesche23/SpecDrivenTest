{
  "builds": [{ "src": "public/**/*", "use": "@vercel/static" }],
  "routes": [
    { "src": "/", "dest": "public/index.html" },
    { "src": "/library", "dest": "public/library.html" },
    { "src": "/settings", "dest": "public/settings.html" },
    { "src": "/game", "dest": "public/game.html" },
    { "src": "/assets/(.*)", "dest": "public/assets/$1" }
  ]
}
